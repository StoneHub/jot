diff --git a/Sources/Vorssaint/Services/Jot/JotBridge.swift b/Sources/Vorssaint/Services/Jot/JotBridge.swift
new file mode 100644
index 00000000..6e451c86
--- /dev/null
+++ b/Sources/Vorssaint/Services/Jot/JotBridge.swift
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Monroe Stone
+
+import AppKit
+import Combine
+import Darwin
+
+/// Fixed local commands only. Notifications are hints; all state is read from
+/// Jot's same-user Unix socket. No transcript endpoints are used.
+final class JotBridge: ObservableObject {
+    static let shared = JotBridge()
+    static let enabledKey = DefaultsKey.jotControlsEnabled
+    static let islandKey = DefaultsKey.jotIslandEnabled
+    struct Snapshot: Decodable, Equatable {
+        var mode: String
+        var meetingActive: Bool
+        var dictation: String?
+        var dictationSequence: UInt64
+        var suggestion: String
+        var suggestionSequence: Int
+        var inputLevel: Double
+    }
+    @Published private(set) var snapshot: Snapshot?
+    @Published private(set) var busy = false
+    @Published private(set) var error: String?
+    @Published private(set) var phase = "idle"
+    @Published var enabled = UserDefaults.standard.object(forKey: enabledKey) as? Bool ?? false {
+        didSet { UserDefaults.standard.set(enabled, forKey: Self.enabledKey); sync() }
+    }
+    @Published var island = UserDefaults.standard.object(forKey: islandKey) as? Bool ?? true {
+        didSet { UserDefaults.standard.set(island, forKey: Self.islandKey); if !island { clearIsland() } }
+    }
+    private var observer: NSObjectProtocol?
+    private var timer: Timer?
+    private var reading = false
+    private var generation = 0
+    private var lastRefresh = Date.distantPast
+    private var lastPresentation = Date.distantPast
+    private var observedSequence: UInt64?
+    private var observedSuggestion: Int?
+    private let queue = DispatchQueue(label: "com.vorssaint.utils.jot", qos: .userInitiated)
+
+    var listening: Bool { snapshot.map { ["ambient", "dictation", "starting"].contains($0.mode) } ?? false }
+    var title: String {
+        guard let snapshot else { return "Open Jot to connect" }
+        if snapshot.meetingActive { return "Meeting recording" }
+        return listening ? "Listening" : "Paused"
+    }
+    func syncWithPreferences() { enabled = UserDefaults.standard.bool(forKey: Self.enabledKey) }
+    func stop() {
+        generation += 1
+        timer?.invalidate(); timer = nil
+        if let observer { DistributedNotificationCenter.default().removeObserver(observer) }
+        observer = nil
+        clearIsland()
+    }
+    private func sync() {
+        stop()
+        guard enabled, AppFeature.jot.isAvailable else { snapshot = nil; return }
+        observer = DistributedNotificationCenter.default().addObserver(
+            forName: Notification.Name("space.jot.app.controlsChanged"), object: nil, queue: .main
+        ) { [weak self] _ in self?.refresh() }
+        let timer = Timer(timeInterval: 0.15, repeats: true) { [weak self] _ in
+            guard let self else { return }
+            // Fast only during a Fn action, otherwise one cheap heartbeat every
+            // two seconds. Never creates a process, opens history, or captures audio.
+            let active = ["capturing", "recognizing", "loading"].contains(self.phase)
+            if Date().timeIntervalSince(self.lastRefresh) >= (active ? 0.15 : 2) { self.refresh() }
+        }
+        timer.tolerance = 0.05
+        RunLoop.main.add(timer, forMode: .common)
+        self.timer = timer
+        refresh()
+    }
+    func refresh() {
+        guard enabled, !reading, !busy else { return }
+        reading = true; lastRefresh = Date()
+        let token = generation
+        queue.async {
+            let result = Result { try Self.request("speech.controls") }
+            DispatchQueue.main.async {
+                self.reading = false
+                guard token == self.generation, self.enabled else { return }
+                switch result {
+                case .success(let data):
+                    do {
+                        let decoded = try JSONDecoder().decode(Snapshot.self, from: data)
+                        if self.snapshot == nil { self.error = nil }
+                        self.receive(decoded)
+                    } catch { self.disconnected("Update Jot to enable its controls connection.") }
+                case .failure(let error): self.disconnected(error.localizedDescription)
+                }
+            }
+        }
+    }
+    private func disconnected(_ message: String) {
+        snapshot = nil; error = message
+        observedSequence = nil; observedSuggestion = nil
+        clearIsland()
+    }
+    private func receive(_ value: Snapshot) {
+        let previous = snapshot
+        snapshot = value
+        let newlyConnected = observedSequence == nil
+        let newHold = observedSequence != value.dictationSequence
+        let newSuggestion = observedSuggestion != value.suggestionSequence
+        observedSequence = value.dictationSequence; observedSuggestion = value.suggestionSequence
+        let active = value.dictation == "capturing" || value.dictation == "recognizing"
+        if active {
+            present(value.dictation!, detail: value.dictation == "capturing" ? "Listening" : "Finishing…")
+        } else if !newlyConnected, previous?.dictation != value.dictation || newHold {
+            switch value.dictation {
+            case "delivered": present("inserted", detail: "Inserted", force: true)
+            case "deliveryFailed", "deliveryUnverified": present("review", detail: "Review saved dictation", force: true)
+            default: clearIsland()
+            }
+        } else if value.suggestion == "loading" {
+            present("loading", detail: "Preparing suggestion…")
+        } else if !newlyConnected, newSuggestion || previous?.suggestion != value.suggestion {
+            switch value.suggestion {
+            case "ready": present("suggestion", detail: "Preview ready · Tab", force: true)
+            case "inserted": present("inserted", detail: "Inserted", force: true)
+            case "insertion-unverified", "selection-unavailable", "insertion-cancelled":
+                present("review", detail: "Check the text field", force: true)
+            default: if phase == "loading" { clearIsland() }
+            }
+        }
+    }
+    private func present(_ next: String, detail: String, force: Bool = false) {
+        let changed = phase != next
+        phase = next
+        guard island, NotchSupport.isEnabled(),
+              force || changed || Date().timeIntervalSince(lastPresentation) >= 1 else { return }
+        lastPresentation = Date()
+        let symbol = ["inserted": "checkmark", "review": "exclamationmark.triangle", "suggestion": "sparkles"][next] ?? "waveform"
+        NotchService.shared.show(NotchNotice(event: .jot, title: "Jot", detail: detail, symbol: symbol))
+    }
+    private func clearIsland() {
+        phase = "idle"
+        NotchService.shared.dismissJotNotice()
+    }
+    func open() { NSWorkspace.shared.open(URL(fileURLWithPath: "/Applications/Jot.app")) }
+    /// Send Jot its normal macOS Quit request. Never terminate this host or
+    /// force-kill a process if Jot refuses or is still finishing work.
+    func quit() {
+        guard !busy else { return }
+        let installedURL = URL(fileURLWithPath: "/Applications/Jot.app").standardizedFileURL
+        guard let app = NSRunningApplication.runningApplications(withBundleIdentifier: "space.jot.app")
+            .first(where: { $0.bundleURL?.standardizedFileURL == installedURL }) else {
+            refresh()
+            return
+        }
+        error = nil
+        guard app.terminate() else {
+            error = "Jot could not quit. Open Jot and try again."
+            return
+        }
+        busy = true
+        let deadline = Date().addingTimeInterval(10)
+        let timer = Timer(timeInterval: 0.2, repeats: true) { [weak self] timer in
+            guard let self else { timer.invalidate(); return }
+            guard app.isTerminated || Date() >= deadline else { return }
+            timer.invalidate()
+            self.busy = false
+            if app.isTerminated {
+                self.snapshot = nil
+                self.clearIsland()
+            } else {
+                self.error = "Jot is still running. Open Jot to finish quitting."
+            }
+        }
+        RunLoop.main.add(timer, forMode: .common)
+    }
+    func toggleListening() { command(listening ? "speech.pause" : "speech.resume") }
+    func meeting() {
+        command(snapshot?.meetingActive == true ? "speech.meeting_end" : "speech.meeting_start",
+                params: snapshot?.meetingActive == true ? [:] : ["title": "Meeting"])
+    }
+    private func command(_ method: String, params: [String: Any] = [:]) {
+        guard enabled, snapshot != nil, !busy else { return }
+        busy = true; error = nil
+        queue.async {
+            let result = Result { try Self.request(method, params: params, timeout: method == "speech.meeting_end" ? 60 : 5) }
+            DispatchQueue.main.async {
+                self.busy = false
+                if case .failure = result { self.error = "Jot could not finish that action. Check Jot before retrying." }
+                self.refresh()
+            }
+        }
+    }
+
+    /// One bounded JSON-line request. No shell, command strings, retry of writes,
+    /// TCP listener or distributed-notification payload is involved.
+    static func request(_ method: String, params: [String: Any] = [:], timeout: Int = 2) throws -> Data {
+        let allowed = ["speech.controls", "speech.pause", "speech.resume", "speech.meeting_start", "speech.meeting_end"]
+        guard allowed.contains(method) else { throw BridgeError.unavailable }
+        let path = NSHomeDirectory() + "/Library/Application Support/Jot/service.sock"
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX); address.sun_len = UInt8(MemoryLayout<sockaddr_un>.size)
+        let bytes = Array(path.utf8) + [0]
+        guard bytes.count <= MemoryLayout.size(ofValue: address.sun_path) else { throw BridgeError.unavailable }
+        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: bytes) }
+        let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+        guard fd >= 0 else { throw BridgeError.unavailable }
+        defer { close(fd) }
+        var yes: Int32 = 1
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &yes, socklen_t(MemoryLayout.size(ofValue: yes)))
+        var interval = timeval(tv_sec: timeout, tv_usec: 0)
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &interval, socklen_t(MemoryLayout.size(ofValue: interval)))
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &interval, socklen_t(MemoryLayout.size(ofValue: interval)))
+        _ = fcntl(fd, F_SETFD, FD_CLOEXEC)
+        let connected = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { Darwin.connect(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+        }
+        var uid: uid_t = 0; var gid: gid_t = 0
+        guard connected == 0, getpeereid(fd, &uid, &gid) == 0, uid == getuid() else { throw BridgeError.unavailable }
+        var frame = try JSONSerialization.data(withJSONObject: ["method": method, "params": params]); frame.append(10)
+        try frame.withUnsafeBytes { buffer in
+            var offset = 0
+            while offset < buffer.count {
+                let count = Darwin.send(fd, buffer.baseAddress!.advanced(by: offset), buffer.count - offset, 0)
+                if count < 0, errno == EINTR { continue }
+                guard count > 0 else { throw BridgeError.unavailable }
+                offset += count
+            }
+        }
+        var response = Data(); var buffer = [UInt8](repeating: 0, count: 4096)
+        let deadline = ProcessInfo.processInfo.systemUptime + Double(timeout)
+        while response.count < 1_048_576, ProcessInfo.processInfo.systemUptime < deadline {
+            let count = recv(fd, &buffer, buffer.count, 0)
+            if count < 0, errno == EINTR { continue }
+            guard count > 0 else { throw BridgeError.unavailable }
+            if let end = buffer.prefix(count).firstIndex(of: 10) {
+                response.append(contentsOf: buffer.prefix(end))
+                guard let object = try JSONSerialization.jsonObject(with: response) as? [String: Any],
+                      object["ok"] as? Bool == true, let result = object["result"] else { throw BridgeError.updateRequired }
+                return try JSONSerialization.data(withJSONObject: result)
+            }
+            response.append(contentsOf: buffer.prefix(count))
+        }
+        throw BridgeError.unavailable
+    }
+    enum BridgeError: LocalizedError {
+        case unavailable, updateRequired
+        var errorDescription: String? {
+            self == .updateRequired ? "Update Jot to enable its controls connection." : "Open Jot to connect."
+        }
+    }
+}
