+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Monroe Stone
+import SwiftUI
+
+struct JotControlsView: View {
+    @ObservedObject private var jot = JotBridge.shared
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            HStack {
+                Label("Jot", systemImage: "waveform").font(.headline)
+                Spacer()
+                Circle().fill(jot.snapshot == nil ? Color.secondary : jot.listening ? .green : .orange).frame(width: 7, height: 7)
+                Text(jot.title).font(.caption).foregroundStyle(.secondary)
+            }
+            HStack(spacing: 10) {
+                Button { jot.toggleListening() } label: {
+                    Label(jot.listening ? "Pause" : "Play", systemImage: jot.listening ? "pause.fill" : "play.fill")
+                        .frame(maxWidth: .infinity)
+                }.disabled(jot.snapshot == nil || jot.busy || !jot.enabled)
+                    .accessibilityIdentifier("jot.listening.toggle")
+                Button { jot.meeting() } label: {
+                    Label(jot.snapshot?.meetingActive == true ? "End meeting" : "Start meeting", systemImage: "record.circle")
+                        .frame(maxWidth: .infinity)
+                }.disabled(jot.snapshot == nil || jot.busy || !jot.enabled)
+                    .accessibilityIdentifier("jot.meeting.toggle")
+            }
+            .buttonStyle(.borderedProminent)
+            Button { jot.open() } label: { Label("Open Jot", systemImage: "arrow.up.forward.app").frame(maxWidth: .infinity) }
+                .buttonStyle(.bordered).accessibilityIdentifier("jot.open")
+            if let error = jot.error { Text(error).font(.caption).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true) }
+            Divider()
+            Toggle("Jot controls", isOn: $jot.enabled).accessibilityIdentifier("jot.controls.enabled")
+            Toggle("Fn activity in Dynamic Island", isOn: $jot.island).disabled(!jot.enabled)
+                .accessibilityIdentifier("jot.island.enabled")
+            Text("Hold Fn to dictate. Double-tap Fn for a suggestion; review the preview and press Tab to insert.")
+                .font(.caption).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true)
+        }
+        .padding(12)
+        .onAppear { jot.refresh() }
+    }
+}
+
+/// Uses Jot's level; it never requests microphone access or reads captured text.
+struct JotActivityMark: View {
+    @ObservedObject private var jot = JotBridge.shared
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    var body: some View {
+        Group {
+            if jot.phase == "capturing" {
+                HStack(spacing: 2) {
+                    ForEach(0..<4) { index in
+                        Capsule().fill(Color.accentColor)
+                            .frame(width: 2, height: reduceMotion ? 9 : 3 + CGFloat(min(1, max(0, jot.snapshot?.inputLevel ?? 0))) * CGFloat([10, 15, 12, 8][index]))
+                    }
+                }.animation(reduceMotion ? nil : .easeOut(duration: 0.12), value: jot.snapshot?.inputLevel)
+            } else if ["recognizing", "loading"].contains(jot.phase) {
+                if reduceMotion { Image(systemName: "ellipsis") }
+                else { ProgressView().controlSize(.mini).scaleEffect(0.7) }
+            } else {
+                Image(systemName: jot.phase == "inserted" ? "checkmark" : jot.phase == "review" ? "exclamationmark.triangle" : "sparkles")
+                    .foregroundStyle(jot.phase == "review" ? Color.orange : .accentColor)
+            }
+        }.frame(width: 18, height: 18).accessibilityHidden(true)
+    }
+}
